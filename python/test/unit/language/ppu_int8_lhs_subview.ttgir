#load = #ttg.blocked<{sizePerThread = [1, 4], threadsPerWarp = [4, 8], warpsPerCTA = [4, 1], order = [1, 0]}>
#row = #ttg.slice<{dim = 1, parent = #load}>
#col = #ttg.slice<{dim = 0, parent = #load}>
#mma = #ttg.ppu_mma<{versionMajor = 1, versionMinor = 0, warpsPerCTA = [1, 4], instrShape = [16, 16], vecSize = 1}>
#qa = #ttg.swizzled_shared<{vec = 16, perPhase = 1, maxPhase = 8, order = [1, 0]}>
#vb = #ttg.swizzled_shared<{vec = 8, perPhase = 1, maxPhase = 16, order = [1, 0]}>
#qaT = #ttg.swizzled_shared<{vec = 16, perPhase = 1, maxPhase = 8, order = [0, 1]}>
#vbT = #ttg.swizzled_shared<{vec = 8, perPhase = 1, maxPhase = 16, order = [0, 1]}>
#smem = #ttg.shared_memory
module attributes {"ttg.num-ctas" = 1 : i32, "ttg.num-warps" = 4 : i32, ttg.target = "cuda:80", "ttg.threads-per-warp" = 32 : i32} {
  tt.func public @subview_dot(%A: !tt.ptr<i8> {tt.divisibility = 16 : i32}, %B: !tt.ptr<i8> {tt.divisibility = 16 : i32}, %Output: !tt.ptr<i32> {tt.divisibility = 16 : i32}) {
    %ar = tt.make_range {start = 0 : i32, end = 16 : i32} : tensor<16xi32, #row>
    %ac = tt.make_range {start = 0 : i32, end = 32 : i32} : tensor<32xi32, #col>
    %as = arith.constant dense<32> : tensor<16xi32, #row>
    %ars = arith.muli %ar, %as : tensor<16xi32, #row>
    %are = tt.expand_dims %ars {axis = 1 : i32} : tensor<16xi32, #row> -> tensor<16x1xi32, #load>
    %arb = tt.broadcast %are : tensor<16x1xi32, #load> -> tensor<16x32xi32, #load>
    %ace = tt.expand_dims %ac {axis = 0 : i32} : tensor<32xi32, #col> -> tensor<1x32xi32, #load>
    %acb = tt.broadcast %ace : tensor<1x32xi32, #load> -> tensor<16x32xi32, #load>
    %aoff = arith.addi %arb, %acb : tensor<16x32xi32, #load>
    %abase = tt.splat %A : !tt.ptr<i8> -> tensor<16x32x!tt.ptr<i8>, #load>
    %aptr = tt.addptr %abase, %aoff : tensor<16x32x!tt.ptr<i8>, #load>, tensor<16x32xi32, #load>
    %av = tt.load %aptr : tensor<16x32x!tt.ptr<i8>, #load>
    %br = tt.make_range {start = 0 : i32, end = 32 : i32} : tensor<32xi32, #row>
    %bc = tt.make_range {start = 0 : i32, end = 128 : i32} : tensor<128xi32, #col>
    %bs = arith.constant dense<128> : tensor<32xi32, #row>
    %brs = arith.muli %br, %bs : tensor<32xi32, #row>
    %bre = tt.expand_dims %brs {axis = 1 : i32} : tensor<32xi32, #row> -> tensor<32x1xi32, #load>
    %brb = tt.broadcast %bre : tensor<32x1xi32, #load> -> tensor<32x128xi32, #load>
    %bce = tt.expand_dims %bc {axis = 0 : i32} : tensor<128xi32, #col> -> tensor<1x128xi32, #load>
    %bcb = tt.broadcast %bce : tensor<1x128xi32, #load> -> tensor<32x128xi32, #load>
    %boff = arith.addi %brb, %bcb : tensor<32x128xi32, #load>
    %bbase = tt.splat %B : !tt.ptr<i8> -> tensor<32x128x!tt.ptr<i8>, #load>
    %bptr = tt.addptr %bbase, %boff : tensor<32x128x!tt.ptr<i8>, #load>, tensor<32x128xi32, #load>
    %bv = tt.load %bptr : tensor<32x128x!tt.ptr<i8>, #load>
    %asmem = ttg.local_alloc %av : (tensor<16x32xi8, #load>) -> !ttg.memdesc<16x32xi8, #qa, #smem>
    %bsmem = ttg.local_alloc %bv : (tensor<32x128xi8, #load>) -> !ttg.memdesc<32x128xi8, #vb, #smem>
    %view = ttg.memdesc_subslice %bsmem[0, @OFFSET@] : !ttg.memdesc<32x128xi8, #vb, #smem> -> !ttg.memdesc<32x64xi8, #vb, #smem, 32x128>
    ttg.local_barrier
    %at = ttg.memdesc_trans %asmem {order = array<i32: 1, 0>} : !ttg.memdesc<16x32xi8, #qa, #smem> -> !ttg.memdesc<32x16xi8, #qaT, #smem>
    %bt = ttg.memdesc_trans %view {order = array<i32: 1, 0>} : !ttg.memdesc<32x64xi8, #vb, #smem, 32x128> -> !ttg.memdesc<64x32xi8, #vbT, #smem, 128x32>
    %ad = ttg.local_load %at : !ttg.memdesc<32x16xi8, #qaT, #smem> -> tensor<32x16xi8, #ttg.dot_op<{opIdx = 1, parent = #mma, kWidth = 4}>>
    %bd = ttg.local_load %bt : !ttg.memdesc<64x32xi8, #vbT, #smem, 128x32> -> tensor<64x32xi8, #ttg.dot_op<{opIdx = 0, parent = #mma, kWidth = 4}>>
    %zero = arith.constant dense<0> : tensor<64x16xi32, #mma>
    %product = tt.dot %bd, %ad, %zero, inputPrecision = tf32 : tensor<64x32xi8, #ttg.dot_op<{opIdx = 0, parent = #mma, kWidth = 4}>> * tensor<32x16xi8, #ttg.dot_op<{opIdx = 1, parent = #mma, kWidth = 4}>> -> tensor<64x16xi32, #mma>
    %result = ttg.convert_layout %product : tensor<64x16xi32, #mma> -> tensor<64x16xi32, #load>
    %or = tt.make_range {start = 0 : i32, end = 64 : i32} : tensor<64xi32, #row>
    %oc = tt.make_range {start = 0 : i32, end = 16 : i32} : tensor<16xi32, #col>
    %os = arith.constant dense<16> : tensor<64xi32, #row>
    %ors = arith.muli %or, %os : tensor<64xi32, #row>
    %ore = tt.expand_dims %ors {axis = 1 : i32} : tensor<64xi32, #row> -> tensor<64x1xi32, #load>
    %orb = tt.broadcast %ore : tensor<64x1xi32, #load> -> tensor<64x16xi32, #load>
    %oce = tt.expand_dims %oc {axis = 0 : i32} : tensor<16xi32, #col> -> tensor<1x16xi32, #load>
    %ocb = tt.broadcast %oce : tensor<1x16xi32, #load> -> tensor<64x16xi32, #load>
    %ooff = arith.addi %orb, %ocb : tensor<64x16xi32, #load>
    %obase = tt.splat %Output : !tt.ptr<i32> -> tensor<64x16x!tt.ptr<i32>, #load>
    %optr = tt.addptr %obase, %ooff : tensor<64x16x!tt.ptr<i32>, #load>, tensor<64x16xi32, #load>
    tt.store %optr, %result : tensor<64x16x!tt.ptr<i32>, #load>
    tt.return
  }
}
